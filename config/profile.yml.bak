target_roles:
  # Your North Star roles — what you're optimizing for
  primary:
    - "Research Associate"
    - "Research Assistant I"
    - "Research Assistant II"
    - "Senior Research Associate"
    - "Research Fellow"
    - "Research Scientist"
    - "Bioinformatics Research Assistant"
    - "Bioinformatics Research Associate"
  # Archetypes help the evaluation system score fit
  archetypes:
    - name: "Biotechnology Research (Cancer/Cardio/Protein)"
      level: "Early Career / New Grad (MS)"
      fit: "primary"        # primary = dream role, secondary = good fit, adjacent = stretch
    - name: "Molecular Biology / Cell Biology Lab"
      level: "Early Career (MS)"
      fit: "secondary"
    - name: "Bioinformatics / Computational Biology"
      level: "Early Career (MS)"
      fit: "adjacent"

narrative:
  # Your professional headline (1 line)
  headline: "Medical biotechnology graduate researcher focused on cardiovascular mechanobiology, molecular biology, and bioinformatics-adjacent research"
  # Your exit story — what makes you unique
  exit_story: "Hands-on research experience spanning cardiovascular valve mechanobiology (Calponin-2 / TGF-β signaling), CRISPR-Cas9 genome editing, and neurodegeneration model systems; comfortable moving from experiment design to data interpretation and clear scientific communication. Targeting university and research institute labs in life sciences (cancer/cardio/protein/omics)."
  # Your top 3-5 superpowers
  superpowers:
    - "Molecular biology + protein biochemistry (CRISPR-Cas9, RT-qPCR, SDS-PAGE, western blot, protein purification)"
    - "Cell & animal model work (cell culture, mouse handling, flow cytometry, microscopy, C. elegans)"
    - "Experimental rigor + documentation (Benchling ELN, analysis, reproducible workflows)"
    - "Mentoring and communication (intern supervision, presentations)"
  # Proof points — projects, articles, case studies with measurable impact
  proof_points:
    - name: "Aortic valve mechanobiology (Cnn2 / TGF-β1)"
      url: ""
      hero_metric: "Mechanotransduction + calcification signaling characterization; pilot small-molecule screen"
    - name: "CRISPR-Cas9 TOPORS knockout (mammalian cells)"
      url: ""
      hero_metric: "gRNA design → plasmid validation → phenotyping with T7 endonuclease + drug sensitivity assays"
    - name: "C. elegans neurodegeneration models"
      url: ""
      hero_metric: "Assayed neuroprotective plant extracts; quantified paralysis/lifespan/behavioral outcomes; mentored 5 interns"
  # Optional: dashboard/demo URL with credentials
  # dashboard:
  #   url: "https://janesmith.dev/demo"
  #   password: "demo-2026"

